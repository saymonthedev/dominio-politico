{
  "name": "dominio-politico",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @dp/web",
    "build": "npm run build -w @dp/web",
    "start": "npm run start -w @dp/web",
    "test": "npm run test -w @dp/engine",
    "typecheck": "npm run typecheck -w @dp/engine && npm run typecheck -w @dp/web",
    "import:2026": "node scripts/import-snapshot/import-2026.mjs",
    "import:historico": "node scripts/import-snapshot/import-historical.mjs",
    "build:startpoints": "node scripts/build-startpoints.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "test:integration": "cd apps/web && tsx --env-file=.env.local scripts/integration.ts",
    "test:private-world": "cd apps/web && tsx --env-file=.env.local scripts/private-world.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "mapshaper": "^0.6.121",
    "tsx": "^4.23.15"
  }
}
